# Database — PostgreSQL. Nunca SQLite, em nenhum ambiente.
# Dev local: suba com `docker compose up -d` (porta 5437).
DATABASE_URL="postgresql://dev:dev@localhost:5437/merlostore_dev?schema=public"

# NextAuth — gerar o secret com: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3005"
NEXTAUTH_SECRET=""

# Cron — rotas sem sessao (/api/alerts/check, /api/transcription).
# O agendador chama com: Authorization: Bearer $CRON_SECRET
# Vazio = as duas rotas respondem 403. Gerar com: openssl rand -hex 32
CRON_SECRET=""

# Cofre das credenciais de integracao (src/lib/cofre.ts).
# Cifra AES-256-GCM os tokens de Bling, TikTok Shop, Instagram e uazapi antes
# de gravar no banco. Vazio = conectar integracao responde 503; o sistema NUNCA
# grava credencial em texto plano.
# Gerar com: openssl rand -hex 32
# NUNCA compartilhar a mesma chave entre HML e PRD. Trocar a chave torna as
# credenciais ja gravadas ilegiveis — e preciso reconectar cada integracao.
INTEGRATIONS_KEY=""

# WhatsApp Cloud API (Fase 2)
WHATSAPP_PHONE_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""          # token do challenge (GET do webhook)
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Meta Graph API - Instagram + Facebook (Fase 2)
META_APP_ID=""
META_APP_SECRET=""                # OBRIGATORIO: valida X-Hub-Signature-256 dos 3 webhooks Meta
META_PAGE_ACCESS_TOKEN=""
META_INSTAGRAM_ACCOUNT_ID=""
INSTAGRAM_VERIFY_TOKEN=""         # token proprio — antes reusava o do WhatsApp
FACEBOOK_VERIFY_TOKEN=""          # token proprio — antes reusava o do WhatsApp

# TikTok — canal de mensagens (Fase 2)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_VERIFY_TOKEN=""            # challenge do GET do webhook

# TikTok Shop (e-commerce) — credenciais do APP, do Partner Center.
# NAO confundir com o TIKTOK_CLIENT_KEY acima: sao APIs diferentes.
# O app_secret e a chave do HMAC que assina as chamadas E valida o webhook;
# sem ele o webhook do TikTok Shop responde 403.
# O token do lojista vem do OAuth e vai cifrado no cofre.
TIKTOK_SHOP_APP_KEY=""
TIKTOK_SHOP_APP_SECRET=""
TIKTOK_SHOP_REDIRECT_URI="http://localhost:3005/api/integracoes/tiktok/callback"

# WhatsApp via uazapi — API NAO-OFICIAL sobre o WhatsApp Web.
# Convive com a Cloud API acima: sao dois provedores do MESMO canal, e cada
# numero escolhe o seu (whatsapp_oficial ou uazapi).
# ATENCAO: e uso fora dos termos do WhatsApp — o numero pode ser BANIDO, a
# sessao cai e precisa reler QR code, e nao existe template aprovado.
#
# UAZAPI_BASE_URL e o host da SUA instalacao (cada cliente tem o proprio
# subdominio); nao ha dominio unico. Ex: https://suaempresa.uazapi.com
# O token de cada numero NAO vem aqui: e por instancia e vai cifrado no cofre.
UAZAPI_BASE_URL=""
# OBRIGATORIO para /api/webhooks/uazapi. Configure o mesmo valor no painel do
# uazapi, em header `x-uazapi-secret` (preferido) ou `?segredo=` na URL.
# Vazio = o webhook responde 403. Gerar com: openssl rand -hex 32
UAZAPI_WEBHOOK_SECRET=""

# Anthropic AI (Fase 8)
ANTHROPIC_API_KEY=""

# OpenAI Whisper (Fase 3 - Transcrição)
OPENAI_API_KEY=""

# Armazenamento de midia — MinIO (ADR 0006), S3-compativel.
# Dev local: `docker compose up -d` sobe o MinIO e cria o bucket PRIVADO.
#   API S3:      http://localhost:9002
#   Console web: http://localhost:9003  (dev / devdevdev)
#
# O bucket NAO pode ser publico: guarda foto de cliente e conversa. O sistema
# serve o binario por /api/media/[id]/raw (com sessao e escopo de loja), e so
# gera URL assinada de TTL curto quando quem baixa e a Meta/uazapi, no envio.
#
# Em producao, apontar para o MinIO da VPS de backend e trocar as chaves —
# nunca reusar as de dev.
S3_ENDPOINT="http://localhost:9002"
S3_BUCKET="merlostore-midia"
S3_ACCESS_KEY="dev"
S3_SECRET_KEY="devdevdev"
S3_REGION="us-east-1"

# Bling (ERP) — credenciais do APP, unicas da instalacao.
# O token do lojista NAO vem aqui: e obtido no OAuth e guardado cifrado no
# cofre (src/lib/cofre.ts). Bling e conta unica da rede; a separacao entre
# Centro e Cerro Azul e por deposito (stores.bling_deposito_id).
# A redirect_uri tem que ser IDENTICA a cadastrada no app do Bling.
BLING_CLIENT_ID=""
BLING_CLIENT_SECRET=""
BLING_REDIRECT_URI="http://localhost:3005/api/integracoes/bling/callback"

# Redis (Fase 5 - Filas FIFO / BullMQ). Dev local via docker compose.
REDIS_URL="redis://localhost:6382"

# Gateway de Pagamento (Fase 7)
PAYMENT_PROVIDER="" # mercadopago | asaas — vazio usa o mock
MERCADOPAGO_ACCESS_TOKEN=""
ASAAS_API_KEY=""
# OBRIGATORIO para /api/webhooks/payments (rota que marca pedido como pago).
# Configure o mesmo valor no painel do gateway; ele volta em x-webhook-secret
# (ou asaas-access-token). Vazio = webhook responde 403.
PAYMENT_WEBHOOK_SECRET=""
